
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lectura de facturas con IA (solo servidor; nunca con prefijo NEXT_PUBLIC_).
# Sin clave, las fotos se leen con Tesseract en el teléfono.
ANTHROPIC_API_KEY=
# Opcionales. Se lee con FACTURA_MODELO (por defecto claude-haiku-5-5) y, solo si no
# cuadra con el total, otra vez con FACTURA_MODELO_RESPALDO (por defecto
# claude-sonnet-5-5; "no" para apagarlo).
FACTURA_MODELO=
FACTURA_MODELO_RESPALDO=
